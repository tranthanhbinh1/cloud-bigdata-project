# Copy to deploy/.env (gitignored) on BOTH machines.

# Tailscale auth key (https://login.tailscale.com/admin/settings/keys).
# Use a *reusable* key, or generate one per machine. Tag/expiry as you prefer.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Tailnet IPv4 of each sidecar node (shown in the admin console after the first `up`,
# or via `docker exec cb-ts-pc tailscale ip -4`). These are stable for a given node.
# NOTE: these are the SIDECAR nodes (cb-pc / cb-mac), not the hosts themselves.
PC_TS_IP=100.x.x.x
MAC_TS_IP=100.y.y.y

# Optional: pin the tailscale image
# TS_IMAGE=tailscale/tailscale:v1.84.0
