# Copy to deploy/.env (gitignored) on BOTH machines.

# LAN IPv4 address of each machine (the PC and the Mac's Wi-Fi/Ethernet address). Give both a DHCP reservation
# in your router so they do not change between runs.
PC_LAN_IP=192.168.x.x
MAC_LAN_IP=192.168.y.y

# Optional
# GRAFANA_PASSWORD=admin
