{
 "uid": "compbench",
 "title": "compbench - cluster overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Host CPU utilisation (%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - avg by (machine) (rate(node_cpu_seconds_total{mode=\"idle\"}[10s])))",
     "legendFormat": "{{machine}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Container CPU (cores)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (machine,name) (rate(container_cpu_usage_seconds_total{name=~\"cb-.*\"}[10s]))",
     "legendFormat": "{{machine}} {{name}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Host memory used (bytes)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
     "legendFormat": "{{machine}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Disk read / write (B/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (machine) (rate(node_disk_read_bytes_total[10s]))",
     "legendFormat": "{{machine}} read"
    },
    {
     "refId": "B",
     "expr": "sum by (machine) (rate(node_disk_written_bytes_total[10s]))",
     "legendFormat": "{{machine}} write"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Network tx / rx (B/s) - PC<->Mac LAN traffic",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(node_network_transmit_bytes_total{device=~\"enp7s0|eth0\"}[10s])",
     "legendFormat": "{{machine}} tx"
    },
    {
     "refId": "B",
     "expr": "rate(node_network_receive_bytes_total{device=~\"enp7s0|eth0\"}[10s])",
     "legendFormat": "{{machine}} rx"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Container CPU (cores): Spark workers",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (machine) (rate(container_cpu_usage_seconds_total{name=~\"cb-spark-worker-.*\"}[10s]))",
     "legendFormat": "{{machine}}"
    }
   ]
  }
 ]
}